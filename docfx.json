{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "KitCli/**.csproj",
            "KitCli.Abstractions/**.csproj",
            "KitCli.Commands/**.csproj",
            "KitCli.Commands.Abstractions/**.csproj",
            "KitCli.Instructions/**.csproj",
            "KitCli.Instructions.Abstractions/**.csproj",
            "KitCli.Workflow/**.csproj",
            "KitCli.Workflow.Abstractions/**.csproj",
            "KitCli.Workflow.Commands/**.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "namespaceLayout": "nested",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["**.md", "**/toc.yml"],
        "src": "docs",
        "dest": "docs",
        "exclude": ["**/0000-template.md"]
      },
      {
        "files": ["index.md", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["docs/dependency-graph.png", "docs/images/*.png"]
      }
    ],
    "output": "_site",
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "sitemap": {
      "baseUrl": "https://kitcli.github.io/KitCli/",
      "changefreq": "weekly"
    },
    "template": ["default", "modern", "templates/kitcli"],
    "globalMetadata": {
      "_appName": "KitCli",
      "_gitContribute": {
        "repo": "https://github.com/KitCli/KitCli",
        "branch": "main"
      },
      "_appLogoPath": "docs/images/logo.png",
      "_appFaviconPath": "docs/images/favicon.png",
      "_appFooter": "<span>KitCli — create an extensible CLI in minutes. Built with <a href=\"https://dotnet.github.io/docfx\">docfx</a>.</span>"
    }
  }
}
